'use client';

import { useState, useEffect } from 'react';
import api from '../../lib/api';

// ============= TYPES =============
interface Prescription {
  id: string;
  consultation_id: string;
  patient_id: string;
  patient_name: string;
  doctor_name: string;
  consultation_date: string;
  diagnosis: string;
  medication: string;
  dosage: string;
  frequency: string;
  route: string;
  duration: string;
  instructions: string;
  status: 'pending' | 'dispensed';
}

interface Stats {
  total: number;
  pending: number;
  dispensed: number;
}

interface ApiResponse<T = unknown> {
  success: boolean;
  data?: T;
  message?: string;
  prescriptions?: Prescription[];
  stats?: Stats;
}

type FilterType = 'all' | 'pending' | 'dispensed';

// ============= COMPONENT =============
export default function PharmacyPage() {
  // State
  const [prescriptions, setPrescriptions] = useState<Prescription[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [filter, setFilter] = useState<FilterType>('all');
  const [stats, setStats] = useState<Stats>({ 
    total: 0, 
    pending: 0, 
    dispensed: 0 
  });

  // ============= DATA FETCHING =============
  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [filter]);

  const fetchData = async (): Promise<void> => {
    setLoading(true);
    try {
      // Fetch prescriptions with filter
      const url = filter !== 'all' 
        ? `/pharmacy/prescriptions?status=${filter}` 
        : '/pharmacy/prescriptions';
      
      const res = await api.get<ApiResponse>(url);
      if (res.data.success && res.data.prescriptions) {
        setPrescriptions(res.data.prescriptions);
      }

      // Fetch stats
      const statsRes = await api.get<ApiResponse>('/pharmacy/stats');
      if (statsRes.data.success && statsRes.data.stats) {
        setStats(statsRes.data.stats);
      }
    } catch (error) {
      console.error('Error fetching pharmacy data:', error);
    } finally {
      setLoading(false);
    }
  };

  // ============= HANDLERS =============
  const handleDispense = async (id: string): Promise<void> => {
    if (!confirm('Dispense this prescription?')) return;
    
    try {
      const res = await api.put<ApiResponse>(`/pharmacy/prescriptions/${id}/dispense`);
      if (res.data.success) {
        alert('✅ Prescription dispensed!');
        await fetchData();
      } else {
        alert('❌ Failed to dispense');
      }
    } catch (error) {
      console.error('Error dispensing:', error);
      alert('❌ Error dispensing prescription');
    }
  };

  // ============= UTILITY FUNCTIONS =============
  const formatDate = (dateStr: string): string => {
    if (!dateStr) return 'N/A';
    try {
      return new Date(dateStr).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      });
    } catch {
      return 'Invalid Date';
    }
  };

  const getStatusBadge = (status: string): JSX.Element => {
    if (status === 'pending') {
      return (
        <span 
          style={{ 
            background: '#FEF3C7', 
            color: '#92400E', 
            padding: '4px 12px', 
            borderRadius: '12px', 
            fontSize: '12px',
            display: 'inline-block'
          }}
        >
          ⏳ Pending
        </span>
      );
    }
    return (
      <span 
        style={{ 
          background: '#DCFCE7', 
          color: '#059669', 
          padding: '4px 12px', 
          borderRadius: '12px', 
          fontSize: '12px',
          display: 'inline-block'
        }}
      >
        ✅ Dispensed
      </span>
    );
  };

  // ============= RENDER HELPERS =============
  const renderStats = (): JSX.Element => (
    <div style={{ 
      display: 'grid', 
      gridTemplateColumns: 'repeat(auto-fit, minmax(150px, 1fr))', 
      gap: '16px', 
      marginBottom: '24px' 
    }}>
      <div style={{ 
        background: 'white', 
        padding: '16px', 
        borderRadius: '8px', 
        border: '1px solid #E2E8F0', 
        textAlign: 'center' 
      }}>
        <div style={{ fontSize: '28px', fontWeight: '700', color: '#2563EB' }}>
          {stats.total}
        </div>
        <div style={{ fontSize: '12px', color: '#475569' }}>
          Total Prescriptions
        </div>
      </div>
      <div style={{ 
        background: 'white', 
        padding: '16px', 
        borderRadius: '8px', 
        border: '1px solid #E2E8F0', 
        textAlign: 'center' 
      }}>
        <div style={{ fontSize: '28px', fontWeight: '700', color: '#D97706' }}>
          {stats.pending}
        </div>
        <div style={{ fontSize: '12px', color: '#475569' }}>
          Pending
        </div>
      </div>
      <div style={{ 
        background: 'white', 
        padding: '16px', 
        borderRadius: '8px', 
        border: '1px solid #E2E8F0', 
        textAlign: 'center' 
      }}>
        <div style={{ fontSize: '28px', fontWeight: '700', color: '#059669' }}>
          {stats.dispensed}
        </div>
        <div style={{ fontSize: '12px', color: '#475569' }}>
          Dispensed
        </div>
      </div>
    </div>
  );

  const renderFilters = (): JSX.Element => (
    <div style={{ 
      display: 'flex', 
      gap: '8px', 
      marginBottom: '20px', 
      flexWrap: 'wrap' 
    }}>
      {(['all', 'pending', 'dispensed'] as FilterType[]).map((filterType) => (
        <button
          key={filterType}
          onClick={() => setFilter(filterType)}
          style={{
            padding: '8px 16px',
            background: filter === filterType ? '#2563EB' : 'white',
            color: filter === filterType ? 'white' : '#475569',
            border: '1px solid #E2E8F0',
            borderRadius: '6px',
            cursor: 'pointer',
            fontWeight: filter === filterType ? '600' : '400',
            transition: 'all 0.2s'
          }}
        >
          {filterType === 'all' && '📋 All'}
          {filterType === 'pending' && '⏳ Pending'}
          {filterType === 'dispensed' && '✅ Dispensed'}
        </button>
      ))}
    </div>
  );

  const renderTable = (): JSX.Element => {
    if (prescriptions.length === 0) {
      return (
        <div style={{ 
          textAlign: 'center', 
          padding: '40px', 
          color: '#94A3B8' 
        }}>
          No prescriptions found
        </div>
      );
    }

    return (
      <table style={{ 
        width: '100%', 
        borderCollapse: 'collapse' 
      }}>
        <thead>
          <tr style={{ 
            background: '#F8FAFC', 
            borderBottom: '1px solid #E2E8F0' 
          }}>
            <th style={{ 
              padding: '12px 16px', 
              textAlign: 'left', 
              color: '#475569', 
              fontSize: '12px', 
              textTransform: 'uppercase' 
            }}>
              Patient
            </th>
            <th style={{ 
              padding: '12px 16px', 
              textAlign: 'left', 
              color: '#475569', 
              fontSize: '12px', 
              textTransform: 'uppercase' 
            }}>
              Medication
            </th>
            <th style={{ 
              padding: '12px 16px', 
              textAlign: 'left', 
              color: '#475569', 
              fontSize: '12px', 
              textTransform: 'uppercase' 
            }}>
              Dosage
            </th>
            <th style={{ 
              padding: '12px 16px', 
              textAlign: 'left', 
              color: '#475569', 
              fontSize: '12px', 
              textTransform: 'uppercase' 
            }}>
              Doctor
            </th>
            <th style={{ 
              padding: '12px 16px', 
              textAlign: 'left', 
              color: '#475569', 
              fontSize: '12px', 
              textTransform: 'uppercase' 
            }}>
              Status
            </th>
            <th style={{ 
              padding: '12px 16px', 
              textAlign: 'left', 
              color: '#475569', 
              fontSize: '12px', 
              textTransform: 'uppercase' 
            }}>
              Action
            </th>
          </tr>
        </thead>
        <tbody>
          {prescriptions.map((prescription) => (
            <tr key={prescription.id} style={{ 
              borderBottom: '1px solid #E2E8F0' 
            }}>
              <td style={{ padding: '12px 16px', color: '#0F172A' }}>
                <div>
                  <div style={{ fontWeight: '500' }}>
                    {prescription.patient_name}
                  </div>
                  <div style={{ fontSize: '11px', color: '#94A3B8' }}>
                    {formatDate(prescription.consultation_date)}
                  </div>
                </div>
              </td>
              <td style={{ padding: '12px 16px', color: '#0F172A' }}>
                <div>
                  <div style={{ fontWeight: '500' }}>
                    {prescription.medication}
                  </div>
                  <div style={{ fontSize: '11px', color: '#94A3B8' }}>
                    {prescription.diagnosis}
                  </div>
                </div>
              </td>
              <td style={{ padding: '12px 16px', color: '#0F172A' }}>
                {prescription.dosage} {prescription.frequency}
                <div style={{ fontSize: '11px', color: '#94A3B8' }}>
                  {prescription.route}
                </div>
              </td>
              <td style={{ padding: '12px 16px', color: '#0F172A' }}>
                {prescription.doctor_name}
              </td>
              <td style={{ padding: '12px 16px' }}>
                {getStatusBadge(prescription.status)}
              </td>
              <td style={{ padding: '12px 16px' }}>
                {prescription.status === 'pending' ? (
                  <button
                    onClick={() => handleDispense(prescription.id)}
                    style={{
                      padding: '6px 14px',
                      background: '#2563EB',
                      color: 'white',
                      border: 'none',
                      borderRadius: '6px',
                      cursor: 'pointer',
                      fontSize: '12px',
                      transition: 'background 0.2s',
                      hover: {
                        background: '#1D4ED8'
                      }
                    }}
                    onMouseEnter={(e) => {
                      e.currentTarget.style.background = '#1D4ED8';
                    }}
                    onMouseLeave={(e) => {
                      e.currentTarget.style.background = '#2563EB';
                    }}
                  >
                    💊 Dispense
                  </button>
                ) : (
                  <span style={{ color: '#94A3B8', fontSize: '12px' }}>
                    ✓ Done
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    );
  };

  // ============= LOADING STATE =============
  if (loading) {
    return (
      <div style={{ 
        padding: '24px', 
        color: '#475569',
        display: 'flex',
        justifyContent: 'center',
        alignItems: 'center',
        minHeight: '400px'
      }}>
        <div>Loading pharmacy data...</div>
      </div>
    );
  }

  // ============= MAIN RENDER =============
  return (
    <div style={{ 
      padding: '24px', 
      maxWidth: '1400px', 
      margin: '0 auto', 
      background: '#F8FAFC', 
      minHeight: '100vh' 
    }}>
      {/* Header */}
      <div style={{ 
        display: 'flex', 
        justifyContent: 'space-between', 
        alignItems: 'center', 
        marginBottom: '24px', 
        flexWrap: 'wrap', 
        gap: '16px' 
      }}>
        <div>
          <h1 style={{ 
            fontSize: '28px', 
            fontWeight: '700', 
            color: '#0F172A', 
            margin: 0 
          }}>
            💊 Pharmacy
          </h1>
          <p style={{ 
            color: '#475569', 
            marginTop: '4px' 
          }}>
            Manage prescriptions and dispensing
          </p>
        </div>
      </div>

      {/* Stats Section */}
      {renderStats()}

      {/* Filters Section */}
      {renderFilters()}

      {/* Prescriptions Table */}
      <div style={{ 
        background: 'white', 
        borderRadius: '12px', 
        border: '1px solid #E2E8F0', 
        overflow: 'hidden' 
      }}>
        {renderTable()}
      </div>
    </div>
  );
}