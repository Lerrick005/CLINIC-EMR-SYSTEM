        frequency: med.frequency || '',
        route: med.route || '',
        duration: med.duration || '',
        instructions: med.instructions || '',
        quantity: med.quantity || 1,
        
        // Status
        status: medStatus,
        status_badge: getStatusBadge(medStatus),
        
