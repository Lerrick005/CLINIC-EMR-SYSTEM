// ============================================
// HELPER FUNCTIONS
// ============================================

// Helper to safely parse JSON
function safeParseJSON(data) {
  if (!data) return {};
  if (typeof data === 'object') return data;
  try {
    return JSON.parse(data);
  } catch (e) {
    return {};
  }
}

// Helper to get status badge color
function getStatusBadge(status) {
  const badges = {
    'PENDING': { color: 'bg-yellow-500', text: 'Pending' },
    'DISPENSED': { color: 'bg-green-500', text: 'Dispensed' },
    'PARTIALLY_DISPENSED': { color: 'bg-blue-500', text: 'Partially Dispensed' },
    'CANCELLED': { color: 'bg-red-500', text: 'Cancelled' }
  };
  return badges[status] || badges['PENDING'];
}

// Helper to check if user can cancel
function canCancel(userRole) {
  return [ROLES.DOCTOR, ROLES.PHARMACIST, ROLES.CLINIC_ADMIN, ROLES.SUPER_ADMIN].includes(userRole);
}

// ============================================
// GET ALL PRESCRIPTIONS
// ============================================
router.get('/prescriptions', requireRole([ROLES.SUPER_ADMIN, ROLES.CLINIC_ADMIN, ROLES.DOCTOR, ROLES.PHARMACIST]), async (req, res, next) => {
  try {
    const db = req.db;
    const clinicId = req.clinicId;
    const { status, patientId, dateFrom, dateTo } = req.query;

    let query = db('consultations')
      .where({ clinic_id: clinicId })
      .whereNotNull('prescriptions')
      .whereRaw("jsonb_array_length(prescriptions) > 0")
      .leftJoin('patients', 'consultations.patient_id', 'patients.id')
      .leftJoin('users as doctor', 'consultations.doctor_id', 'doctor.id')
      .select(
        'consultations.id as consultation_id',
        'consultations.patient_id',
        'consultations.prescriptions',
        'consultations.consultation_date',
        'consultations.doctor_id',
        'consultations.diagnosis',
        'consultations.amount_due',
        'patients.first_name as patient_first_name',
        'patients.last_name as patient_last_name',
        'patients.phone as patient_phone',
        'patients.medical_no',
        'doctor.first_name as doctor_first_name',
        'doctor.last_name as doctor_last_name'
      );

    // Filter by patient
    if (patientId) {
      query = query.where({ patient_id: patientId });
    }

    // Filter by date range
    if (dateFrom) {
      query = query.where('consultation_date', '>=', dateFrom);
    }
    if (dateTo) {
      query = query.where('consultation_date', '<=', dateTo);
    }

    const consultations = await query.orderBy('consultation_date', 'desc');

    // Format the response - flatten prescriptions
    const prescriptions = [];
    consultations.forEach(c => {
      const meds = safeParseJSON(c.prescriptions) || [];
      meds.forEach((med, index) => {
        // Determine status
        const medStatus = med.status || 'PENDING';
        
        // Only filter by status if requested
        if (status && medStatus !== status) {
          return;
        }

        prescriptions.push({
          id: `${c.consultation_id}-${index}`,
          consultation_id: c.consultation_id,
          patient_id: c.patient_id,
          patient_name: `${c.patient_first_name || ''} ${c.patient_last_name || ''}`.trim(),
          patient_phone: c.patient_phone || '',
          medical_no: c.medical_no || '',
          doctor_name: `${c.doctor_first_name || ''} ${c.doctor_last_name || ''}`.trim(),
          doctor_id: c.doctor_id,
          consultation_date: c.consultation_date,
          diagnosis: c.diagnosis,
          amount_due: c.amount_due,
          
          // Medication details
          medication: med.name || med.medication || 'Unknown',
          dosage: med.dosage || med.dose || '',
          frequency: med.frequency || '',
          route: med.route || '',
          duration: med.duration || '',
          instructions: med.instructions || '',
          quantity: med.quantity || 1,
          
          // Status
          status: medStatus,
          status_badge: getStatusBadge(medStatus),
          
          // Dispensing info
          dispensed_quantity: med.dispensed_quantity || 0,
          dispensed_at: med.dispensed_at || null,
          dispensed_by: med.dispensed_by || null,
          dispensed_notes: med.dispensed_notes || '',
          
          // History
          history: med.history || [],
          
          // Timestamps
          created_at: med.created_at || c.consultation_date,
          updated_at: med.updated_at || c.consultation_date,
          expiry_date: med.expiry_date || null,
          
          // For UI
          is_dispensed: medStatus === 'DISPENSED',
          is_partial: medStatus === 'PARTIALLY_DISPENSED',
          is_pending: medStatus === 'PENDING',
          is_cancelled: medStatus === 'CANCELLED'
        });
      });
    });

    res.json({ 
      success: true, 
      prescriptions,
      total: prescriptions.length,
      stats: {
        pending: prescriptions.filter(p => p.status === 'PENDING').length,
        dispensed: prescriptions.filter(p => p.status === 'DISPENSED').length,
        partial: prescriptions.filter(p => p.status === 'PARTIALLY_DISPENSED').length,
        cancelled: prescriptions.filter(p => p.status === 'CANCELLED').length
      }
    });
  } catch (err) {
    console.error('Error fetching prescriptions:', err);
    next(err);
  }
});

