// ============================================
// DISPENSE PRESCRIPTION (Full or Partial)
// ============================================
router.put('/prescriptions/:id/dispense', requireRole([ROLES.SUPER_ADMIN, ROLES.CLINIC_ADMIN, ROLES.PHARMACIST]), async (req, res, next) => {
  try {
    const db = req.db;
    const clinicId = req.clinicId;
    const userId = req.user.id;
    const userRole = req.user.role;
    const userName = `${req.user.first_name || ''} ${req.user.last_name || ''}`.trim() || 'Pharmacist';
    
    const { id } = req.params;
    const { 
      quantity_dispensed, 
      notes, 
      status = 'DISPENSED' 
    } = req.body;

    // id format: consultation_id-index
    const [consultationId, medIndex] = id.split('-');

    // Get consultation
    const consultation = await db('consultations')
      .where({ clinic_id: clinicId, id: consultationId })
      .first();

    if (!consultation) {
      return res.status(404).json({ error: 'Consultation not found' });
    }

    let prescriptions = safeParseJSON(consultation.prescriptions) || [];
    const index = parseInt(medIndex);
    
    if (index >= prescriptions.length) {
      return res.status(404).json({ error: 'Medication not found' });
    }

    const med = prescriptions[index];
    
    // Check if already dispensed
    if (med.status === 'DISPENSED') {
      return res.status(400).json({ error: 'Prescription already dispensed' });
    }

    // Check if cancelled
    if (med.status === 'CANCELLED') {
      return res.status(400).json({ error: 'Prescription has been cancelled' });
    }

    // Calculate dispensed quantity
    const totalQuantity = med.quantity || 1;
    const dispensedQty = quantity_dispensed || totalQuantity;
    
    // Determine new status
    let newStatus;
    if (dispensedQty >= totalQuantity) {
      newStatus = 'DISPENSED';
    } else if (dispensedQty > 0) {
      newStatus = 'PARTIALLY_DISPENSED';
    } else {
      return res.status(400).json({ error: 'Quantity dispensed must be greater than 0' });
    }

    // Create history entry
    const historyEntry = {
      status: newStatus,
      timestamp: new Date().toISOString(),
      actor: userId,
      actor_name: userName,
      actor_role: userRole,
      notes: notes || `Dispensed ${dispensedQty} of ${totalQuantity} ${med.name}`
    };

    // Update prescription
    prescriptions[index] = {
      ...med,
      status: newStatus,
      dispensed_quantity: dispensedQty,
      dispensed_at: new Date().toISOString(),
      dispensed_by: userId,
      dispensed_notes: notes || '',
      history: [...(med.history || []), historyEntry],
      updated_at: new Date().toISOString()
    };

    // Update consultation
    await db('consultations')
      .where({ id: consultationId })
      .update({
        prescriptions: JSON.stringify(prescriptions),
        updated_at: db.fn.now(),
        // If all prescriptions dispensed, mark consultation as dispensed
        status: newStatus === 'DISPENSED' ? 'dispensed' : 'completed'
      });

    // ============================================
    // SEND NOTIFICATIONS (Real-time + Database)
    // ============================================
    const notificationService = new NotificationService(db);

    // Get patient details
    const patient = await db('patients')
      .where({ id: consultation.patient_id })
      .first();
    
    const patientName = patient ? `${patient.first_name || '} ${patient.last_name || '}`.trim() : 'Patient';

    // 1. Real-time notification via Socket.io
    // Notify doctor who prescribed (if not the one cancelling)
    if (consultation.doctor_id && consultation.doctor_id !== userId) {
      emitToUser(consultation.doctor_id, 'notification:new', {
        title: '🚫 Prescription Cancelled',
        message: `${med.name} for ${patientName} was cancelled by ${userName}`,
        type: 'prescription_cancelled',
        reference_id: consultationId,
        reference_type: 'consultation',
        reason: reason
      });
    }

    // 2. Database notifications using NotificationService
    await notificationService.onPrescriptionCancelled(
      consultation,
      med,
      clinicId,
      userId,
      consultation.patient_id,
      reason
    );

    // ============================================
    // SEND NOTIFICATIONS (Real-time + Database)
    // ============================================
    const notificationService = new NotificationService(db);

    // Get patient details
    const patient = await db('patients')
      .where({ id: consultation.patient_id })
      .first();
    
    const patientName = patient ? `${patient.first_name || '} ${patient.last_name || '}`.trim() : 'Patient';

    // 1. Real-time notifications via Socket.io
    const notificationMessage = newStatus === 'DISPENSED' 
      ? `✅ ${patientName} - Prescription ready for pickup (${med.name})`
      : `⚠️ ${patientName} - Partially dispensed (${dispensedQty}/${totalQuantity} ${med.name})`;
    
    emitToClinic(clinicId, 'notification:new', {
      title: newStatus === 'DISPENSED' ? '💊 Prescription Ready' : '⚠️ Partial Dispense',
      message: notificationMessage,
      type: newStatus === 'DISPENSED' ? 'prescription_ready' : 'prescription_partial',
      reference_id: consultationId,
      reference_type: 'consultation',
      priority: 'high',
      patient_name: patientName,
      medication: med.name,
      quantity: `${dispensedQty}/${totalQuantity}`
    });

    // Notify the doctor who prescribed (real-time)
    if (consultation.doctor_id) {
      emitToUser(consultation.doctor_id, 'notification:new', {
        title: newStatus === 'DISPENSED' ? '💊 Prescription Dispensed' : '⚠️ Prescription Partially Dispensed',
        message: `${med.name} for ${patientName} - ${newStatus === 'DISPENSED' ? 'Fully dispensed' : `Partially dispensed (${dispensedQty}/${totalQuantity})`}`,
        type: 'prescription_dispensed',
        reference_id: consultationId,
        reference_type: 'consultation'
      });
    }

    // 2. Database notifications using NotificationService
    if (newStatus === 'DISPENSED') {
      await notificationService.onPrescriptionDispensed(
        consultation,
        med,
        clinicId,
        userId,
        consultation.patient_id
      );
    } else if (newStatus === 'PARTIALLY_DISPENSED') {
      await notificationService.onPrescriptionPartiallyDispensed(
        consultation,
        med,
        clinicId,
        userId,
        consultation.patient_id,
        dispensedQty,
        totalQuantity
      );
    }

    // 3. Also save a notification for the pharmacist (confirmation)
    await notificationService.createNotification({
      userId: userId,
      clinicId: clinicId,
      title: newStatus === 'DISPENSED' ? '✅ Dispense Complete' : '⚠️ Partial Dispense Complete',
      message: `${med.name} ${newStatus === 'DISPENSED' ? 'fully' : 'partially'} dispensed to ${patientName}`,
      type: 'dispense_confirmation',
      referenceId: consultationId,
      referenceType: 'consultation'
    });

    // ============================================
    // SEND NOTIFICATIONS
    // ============================================
    
    // Get patient details
    const patient = await db('patients')
      .where({ id: consultation.patient_id })
      .first();
    
    const patientName = patient ? `${patient.first_name || ''} ${patient.last_name || ''}`.trim() : 'Patient';

    // 1. Notify RECEPTION that prescription is ready
    const notificationMessage = newStatus === 'DISPENSED' 
      ? `âœ… ${patientName} - Prescription ready for pickup (${med.name})`
      : `âš ï¸ ${patientName} - Partially dispensed (${dispensedQty}/${totalQuantity} ${med.name})`;
    
    emitToClinic(clinicId, 'notification:new', {
      title: newStatus === 'DISPENSED' ? 'ðŸ’Š Prescription Ready' : 'âš ï¸ Partial Dispense',
      message: notificationMessage,
      type: newStatus === 'DISPENSED' ? 'prescription_ready' : 'prescription_partial',
      reference_id: consultationId,
      reference_type: 'consultation',
      priority: 'high',
      patient_name: patientName,
      medication: med.name,
      quantity: `${dispensedQty}/${totalQuantity}`
    });

    // 2. Notify the doctor who prescribed
    if (consultation.doctor_id) {
      emitToUser(consultation.doctor_id, 'notification:new', {
        title: newStatus === 'DISPENSED' ? 'ðŸ’Š Prescription Dispensed' : 'âš ï¸ Prescription Partially Dispensed',
        message: `${med.name} for ${patientName} - ${newStatus === 'DISPENSED' ? 'Fully dispensed' : `Partially dispensed (${dispensedQty}/${totalQuantity})`}`,
        type: 'prescription_dispensed',
        reference_id: consultationId,
        reference_type: 'consultation'
      });
    }

    // 3. Notify the pharmacist who dispensed (confirmation)
    emitToUser(userId, 'notification:new', {
      title: 'âœ… Dispense Successful',
      message: `${med.name} dispensed to ${patientName}`,
      type: 'dispense_confirmation',
      reference_id: consultationId,
      reference_type: 'consultation'
    });

    res.json({
      success: true,
      message: newStatus === 'DISPENSED' ? 'Prescription dispensed successfully' : 'Prescription partially dispensed',
      data: {
        consultation_id: consultationId,
        medication: med.name,
        status: newStatus,
        dispensed_quantity: dispensedQty,
        total_quantity: totalQuantity,
        notes: notes || ''
      }
    });
  } catch (err) {
    console.error('Error dispensing prescription:', err);
    next(err);
  }
});

