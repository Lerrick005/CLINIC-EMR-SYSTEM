    res.json({
      success: true,
      message: 'Prescription cancelled successfully',
      data: {
        consultation_id: consultationId,
        medication: med.name,
        status: 'CANCELLED',
        reason: reason
      }
    });
  } catch (err) {
    console.error('Error cancelling prescription:', err);
    next(err);
  }
});

// ============================================
// GET PRESCRIPTION HISTORY
// ============================================
router.get('/prescriptions/:id/history', requireRole([ROLES.SUPER_ADMIN, ROLES.CLINIC_ADMIN, ROLES.DOCTOR, ROLES.PHARMACIST]), async (req, res, next) => {
  try {
    const db = req.db;
    const clinicId = req.clinicId;
    const { id } = req.params;

    // id format: consultation_id-index
    const [consultationId, medIndex] = id.split('-');

    // Get consultation
    const consultation = await db('consultations')
      .where({ clinic_id: clinicId, id: consultationId })
      .first();

    if (!consultation) {
      return res.status(404).json({ error: 'Consultation not found' });
    }

    const prescriptions = safeParseJSON(consultation.prescriptions) || [];
    const index = parseInt(medIndex);
    
    if (index >= prescriptions.length) {
      return res.status(404).json({ error: 'Medication not found' });
    }

    const med = prescriptions[index];
    const history = med.history || [];

    res.json({
      success: true,
      history: history,
      medication: med.name || med.medication || 'Unknown',
      current_status: med.status || 'PENDING'
    });
  } catch (err) {
    console.error('Error fetching prescription history:', err);
    next(err);
  }
});

// ============================================
// GET PHARMACY STATISTICS
// ============================================
router.get('/stats', requireRole([ROLES.SUPER_ADMIN, ROLES.CLINIC_ADMIN, ROLES.PHARMACIST]), async (req, res, next) => {
  try {
    const db = req.db;
    const clinicId = req.clinicId;

    // Get all consultations with prescriptions
    const consultations = await db('consultations')
      .where({ clinic_id: clinicId })
      .whereNotNull('prescriptions')
      .whereRaw("jsonb_array_length(prescriptions) > 0")
      .select('prescriptions');

    let total = 0;
    let pending = 0;
    let dispensed = 0;
    let partiallyDispensed = 0;
    let cancelled = 0;

    consultations.forEach(c => {
      const meds = safeParseJSON(c.prescriptions) || [];
      meds.forEach(med => {
        total++;
        const status = med.status || 'PENDING';
        switch (status) {
          case 'PENDING': pending++; break;
          case 'DISPENSED': dispensed++; break;
          case 'PARTIALLY_DISPENSED': partiallyDispensed++; break;
          case 'CANCELLED': cancelled++; break;
        }
      });
    });

    res.json({
      success: true,
      stats: {
        total,
        pending,
        dispensed,
        partially_dispensed: partiallyDispensed,
        cancelled,
        dispense_rate: total > 0 ? ((dispensed / total) * 100).toFixed(1) : 0
      }
    });
  } catch (err) {
    console.error('Error fetching pharmacy stats:', err);
    next(err);
  }
});

// ============================================
// GET RECENT DISPENSING ACTIVITY
// ============================================
router.get('/activity', requireRole([ROLES.SUPER_ADMIN, ROLES.CLINIC_ADMIN, ROLES.PHARMACIST]), async (req, res, next) => {
  try {
    const db = req.db;
    const clinicId = req.clinicId;
    const limit = parseInt(req.query.limit) || 20;

    const consultations = await db('consultations')
      .where({ clinic_id: clinicId })
      .whereNotNull('prescriptions')
      .whereRaw("jsonb_array_length(prescriptions) > 0")
      .leftJoin('patients', 'consultations.patient_id', 'patients.id')
      .leftJoin('users as pharmacist', 'consultations.prescriptions->>dispensed_by', 'pharmacist.id')
      .select(
        'consultations.id as consultation_id',
        'consultations.patient_id',
        'consultations.prescriptions',
        'consultations.consultation_date',
        'consultations.updated_at',
        'patients.first_name as patient_first_name',
        'patients.last_name as patient_last_name',
        'pharmacist.first_name as pharmacist_first_name',
        'pharmacist.last_name as pharmacist_last_name'
      )
      .orderBy('consultations.updated_at', 'desc')
      .limit(limit);

    const activities = [];
    consultations.forEach(c => {
      const meds = safeParseJSON(c.prescriptions) || [];
      meds.forEach(med => {
        if (med.status === 'DISPENSED' || med.status === 'PARTIALLY_DISPENSED') {
          activities.push({
            consultation_id: c.consultation_id,
            patient_name: `${c.patient_first_name || ''} ${c.patient_last_name || ''}`.trim(),
            medication: med.name || med.medication || 'Unknown',
            status: med.status,
            dispensed_quantity: med.dispensed_quantity || 0,
            total_quantity: med.quantity || 1,
            dispensed_at: med.dispensed_at,
            pharmacist_name: `${c.pharmacist_first_name || ''} ${c.pharmacist_last_name || ''}`.trim() || 'Unknown',
            notes: med.dispensed_notes || ''
          });
        }
      });
    });

    res.json({
      success: true,
      activities: activities.slice(0, limit)
    });
  } catch (err) {
    console.error('Error fetching pharmacy activity:', err);
    next(err);
  }
});

module.exports = router;
